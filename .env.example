# Copy to .env, generate a random value (see README), and load it into the
# backend process environment. Do not commit the populated file.
CATCHUP_SECRET_KEY=
# Optional for source checkouts; defaults to ./data.
# CATCHUP_DATA_DIR=./data
# Optional location of a built frontend (defaults to frontend/dist in a source checkout).
# CATCHUP_FRONTEND_DIST=/path/to/frontend/dist
CATCHUP_FIRST_ADD_DAYS=7
CATCHUP_FIRST_ADD_MAX=5
CATCHUP_SHORT_TEXT_CHARS=500
# CATCHUP_MAX_FEED_BYTES=33554432
# CATCHUP_TRANSCRIPT_WAIT_DAYS=7
# CATCHUP_CAPTION_WAIT_HOURS=24
# CATCHUP_CAPTIONS_PER_RUN=20
# CATCHUP_LONG_ITEM_CHARS=20000
# CATCHUP_SINGLE_CALL_CHARS=60000
CATCHUP_GROUPING_BATCH_CHARS=200000
# Local Host headers only by default; add your deployment domain if needed.
CATCHUP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional printable ASCII contact (up to 100 characters) in the source User-Agent.
# CATCHUP_USER_AGENT_CONTACT=by /u/example
