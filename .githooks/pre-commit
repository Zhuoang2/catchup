#!/bin/bash
# Block commits whose added lines look like real credentials.
added=$(git diff --cached -U0 --no-color -- . ':(exclude)package-lock.json' ':(exclude)*.lock' | grep -v '^+++ ' | grep '^+')
if grep -Eq 'sk-[A-Za-z0-9_-]{20,}|CATCHUP_SECRET_KEY=[A-Za-z0-9_=-]{20,}|BEGIN [A-Z ]*PRIVATE KEY' <<<"$added"; then
  echo "pre-commit: staged changes look like they contain an API key or secret; commit blocked." >&2
  exit 1
fi
exit 0
